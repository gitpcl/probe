{
    "name": "gitpcl/probe",
    "description": "Agent-first Laravel testing runtime: warm PHP workers, compact JSON probes, selective tests, and optional browser, mutation, and formal checks.",
    "keywords": ["laravel", "testing", "probe", "phpunit", "pest", "agents"],
    "homepage": "https://github.com/gitpcl/probe",
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/gitpcl/probe/issues",
        "source": "https://github.com/gitpcl/probe"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "ext-pcntl": "Probe timeouts and worker signals use pcntl when it is loaded.",
        "ext-posix": "Stale warm-worker detection uses posix when it is loaded.",
        "ext-pdo_sqlite": "The default probe database is SQLite :memory:."
    },
    "autoload": {
        "psr-4": {
            "Probe\\": "src/"
        },
        "files": [
            "src/Runner/execute_snippet.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Probe\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/probe"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Probe\\ProbeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@lint",
            "@analyse"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
